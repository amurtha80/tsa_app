[Unit]
Description=FlyASAP Quack DB server (tsa_app.duckdb)
After=network.target local-fs.target

[Service]
Type=simple
User=jmurtha80
Group=jmurtha80
WorkingDirectory=/mnt/ssd/tsa_app
Environment=HOME=/home/jmurtha80
ExecStart=/usr/bin/Rscript /mnt/ssd/tsa_app/02_Scripts/zz_database.R
